{
  "info": {
    "_postman_id": "c0af94a7-3d58-4ab1-8d76-dayfrefund001",
    "name": "DAYF Booking - Cancellation, Refund & Boosting",
    "description": "End-to-end policy configuration, guest cancellation, admin-managed manual refund and listing-boost verification. Set userToken, adminToken and bookingId before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "hotelOwnerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "refundRequestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "manualRefundReference",
      "value": "SATIM-REF-123456",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Cancellation Policy",
      "item": [
        {
          "name": "Get Active Cancellation Policy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/refund-requests/policy",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "policy"]
            },
            "description": "Public endpoint used by the property form and booking checkout page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Policy contains configurable rules', function () {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('depositRate');",
                  "  pm.expect(data).to.have.property('freeCancellationDays');",
                  "  pm.expect(data).to.have.property('policyText');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin - Update Cancellation Policy",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depositRate\": 15,\n  \"freeCancellationDays\": 7,\n  \"refundProcessingHours\": 48,\n  \"creditDelayMinBusinessDays\": 3,\n  \"creditDelayMaxBusinessDays\": 7,\n  \"listingBoostDays\": 7,\n  \"noShowReportWindowHours\": 2,\n  \"hostSuspensionDays\": 7,\n  \"policyText\": \"The deposit paid at booking represents 15% of the total stay amount and is non-refundable in cases of guest cancellation within 7 days of check-in or no-show. Cancellations made more than 7 days before check-in are eligible for a full refund, processed within 48 hours and credited within 3 to 7 business days.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/refund-requests/policy",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "policy"]
            },
            "description": "Admin-only. Changes apply to new bookings; existing bookings keep their saved policy snapshot."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Policy updated successfully', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Guest Cancellation",
      "item": [
        {
          "name": "Create Cancellation & Refund Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"My travel plans have changed and I cannot complete this stay.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/refund-requests/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "booking", "{{bookingId}}"]
            },
            "description": "The booking must belong to the authenticated guest and must be confirmed and paid. Cancellation releases calendar dates immediately. More than 7 days before check-in creates a pending refundable request; otherwise status is not_eligible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancellation request created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set('refundRequestId', json.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Refund Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/refund-requests/my",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "my"]
            },
            "description": "Returns only the authenticated guest's refund requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Hotel Owner Actions",
      "item": [
        {
          "name": "Host Cancels Confirmed Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hotelOwnerToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"The property is unexpectedly unavailable for the confirmed dates.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/refund-requests/booking/{{bookingId}}/host-cancel",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "booking", "{{bookingId}}", "host-cancel"]
            },
            "description": "Creates a full-deposit refund request, releases calendar dates, suspends the host for the configured period and adds a public cancellation note. A cancellation after check-in is marked blocked_review and suspicious."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Host cancellation created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) pm.collectionVariables.set('refundRequestId', json.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Host Reports Guest No-Show",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hotelOwnerToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"The guest did not arrive at the scheduled check-in time.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/refund-requests/booking/{{bookingId}}/no-show",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "booking", "{{bookingId}}", "no-show"]
            },
            "description": "Can be submitted only after scheduled check-in. Reports within the configured 2-hour window receive listing boost; late reports are recorded without boost. The guest deposit remains non-refundable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No-show report created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Refund Management",
      "item": [
        {
          "name": "Get Pending Refund Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/refund-requests?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            },
            "description": "Admin, sub-admin and super-admin can list refund requests. Remove the status query to list all."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve Refund Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"adminNote\": \"The request meets the cancellation policy and is approved for manual SATIM refund.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/refund-requests/{{refundRequestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "{{refundRequestId}}"]
            },
            "description": "Approves an eligible request but does not claim that money was refunded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refund request approved', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('approved');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark Manual Refund Completed",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"refunded\",\n  \"adminNote\": \"The deposit refund was completed manually via SATIM.\",\n  \"manualRefundReference\": \"{{manualRefundReference}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/refund-requests/{{refundRequestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "{{refundRequestId}}"]
            },
            "description": "Call only after the admin has completed the external refund. A manual reference is mandatory. This also marks payment and booking payment status as refunded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Manual refund marked completed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('refunded');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Refund Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"adminNote\": \"The request does not meet the refund requirements.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/refund-requests/{{refundRequestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["refund-requests", "{{refundRequestId}}"]
            },
            "description": "Use this instead of approve/refunded when an otherwise eligible request fails admin review."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refund request rejected', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('rejected');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Boosting Verification",
      "description": "After a successful guest cancellation, the related apartment is boosted for the number of days configured in listingBoostDays. Boosted listings appear first; regular listings still remain in the response.",
      "item": [
        {
          "name": "Verify Boost Priority - Apartments Listing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/apartments?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["apartments"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Returns all matching apartments with active boosted apartments first. The response data items expose isBoosted and boostedUntil."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Boosted apartments are before regular apartments', function () {",
                  "  const body = pm.response.json();",
                  "  const items = body.data && Array.isArray(body.data.data) ? body.data.data : [];",
                  "  let regularFound = false;",
                  "  items.forEach(function (item) {",
                  "    if (!item.isBoosted) regularFound = true;",
                  "    if (regularFound) pm.expect(item.isBoosted).to.not.eql(true);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Boost Priority - Home Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/properties/home-page-data",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "home-page-data"]
            },
            "description": "Returns up to 10 apartments. Active boosted apartments are first and remaining slots are filled by regular apartments."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Home page returns no more than 10 apartments', function () {",
                  "  const items = pm.response.json().data || [];",
                  "  pm.expect(items.length).to.be.at.most(10);",
                  "});",
                  "pm.test('Boosted home-page items are first', function () {",
                  "  const items = pm.response.json().data || [];",
                  "  let regularFound = false;",
                  "  items.forEach(function (item) {",
                  "    if (!item.isBoosted) regularFound = true;",
                  "    if (regularFound) pm.expect(item.isBoosted).to.not.eql(true);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
